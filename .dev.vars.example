# Copy to .dev.vars for local development (`npm run dev`). .dev.vars is git-ignored.

# Cloudflare's official Turnstile test keys: the widget always passes and the server always accepts it.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Leave empty locally to print notification emails to the terminal instead of sending them.
RESEND_API_KEY=
